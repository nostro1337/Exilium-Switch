{
  "name": "exilium-switch",
  "version": "1.5.2",
  "type": "module",
  "description": "Exilium Switch",
  "productName": "Exilium Switch",
  "main": "dist-electron/main.js",
  "author": "Nostro",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:dev": "npm run build && electron-builder --win dir --config.directories.output=release/DevBuild && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/patch-executable.ps1 -TargetDir release/DevBuild/win-unpacked",
    "build:dir": "npm run build:dev",
    "package": "npm run build && electron-builder --win nsis portable --config.directories.output=release/Versions",
    "package:installer": "npm run build && electron-builder --win nsis --config.directories.output=release/Versions",
    "package:portable": "npm run build && electron-builder --win portable --config.directories.output=release/Versions",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "start": "electron ."
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "framer-motion": "^12.4.7",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.4.20",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "happy-dom": "^20.11.12",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^4.1.11"
  }
}
